# Default demo: CSV sample profile, simulated invocations, no API keys required.
HOST=127.0.0.1
PORT=8000
# Optional live providers. Process environment overrides this file.
ENTSOE_API_KEY=
USE_LIVE_API=false
ELECTRICITY_MAPS_API_KEY=
# Optional local OpenWhisk integration; supply your own credentials.
OPENWHISK_REAL=false
OPENWHISK_HOST=http://localhost:3233
OPENWHISK_AUTH=
# Estimated energy, not a measured invocation energy value.
ENERGY_KWH_PER_REQUEST=0.001
# Optional SQLite path. Omit to use routing.db in the project directory.
# DATABASE_PATH=
